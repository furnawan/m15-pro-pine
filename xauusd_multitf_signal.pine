//@version=5
indicator("XAUUSD Multi-TF Signal (H1 Trend + M1 Entry)", overlay=true)

// ─── Settings ───
grp_main     = "Signal Settings"
fastLen      = input.int(12, "EMA Fast (M1)", group=grp_main)
slowLen      = input.int(34, "EMA Slow (M1)", group=grp_main)
h1Len        = input.int(60, "H1 Trend Length (bars)", group=grp_main)
minDiff      = input.float(1.5, "Min EMA Diff (pts)", step=0.1, group=grp_main)
slPts        = input.float(3.0, "Stop Loss (pts)", step=0.1, group=grp_main)
tpPts        = input.float(4.5, "Take Profit (pts)", step=0.1, group=grp_main)

grp_visual   = "Visual"
showLabels   = input.bool(true, "Show Buy/Sell Labels", group=grp_visual)
showSLTP     = input.bool(true, "Show SL/TP Lines", group=grp_visual)
showHTF      = input.bool(true, "Show H1 Trend Background", group=grp_visual)

// ─── Higher Timeframe Trend (H1) ───
// Request H1 close data
[h1Close, h1Open] = request.security(syminfo.tickerid, "60", [close, open], lookahead=barmerge.lookahead_on)
h1EMA = ta.ema(h1Close, h1Len)
h1Bull = h1Close > h1EMA
h1Bear = h1Close < h1EMA

// ─── M1 Calculations ───
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
diff    = emaFast - emaSlow

// ─── Signal Logic ───
buyCond  = h1Bull and diff > minDiff and close > emaFast
sellCond = h1Bear and diff < -minDiff and close < emaFast

// ─── State for deduplication ───
var lastSig = "NONE"
sig = "NONE"
if buyCond and lastSig != "BUY"
    sig := "BUY"
    lastSig := "BUY"
else if sellCond and lastSig != "SELL"
    sig := "SELL"
    lastSig := "SELL"

// ─── SL / TP ───
slPrice = sig == "BUY" ? close - slPts : sig == "SELL" ? close + slPts : na
tpPrice = sig == "BUY" ? close + tpPts : sig == "SELL" ? close - tpPts : na

// ─── Plotting ───
plot(emaFast, "EMA Fast", color=color.green, linewidth=1)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=1)

// H1 Trend Background
bgcolor(h1Bull and showHTF ? color.new(color.green, 90) : h1Bear and showHTF ? color.new(color.red, 90) : na, title="H1 Trend")

// Signal Markers
plotshape(buyCond and showLabels,  "BUY",  shape.labelup,   location.belowbar, color.green,  size=size.normal, text="🟢 BUY")
plotshape(sellCond and showLabels, "SELL", shape.labeldown, location.abovebar, color.red,    size=size.normal, text="🔴 SELL")

// SL/TP Lines
plot(showSLTP and not na(slPrice) ? slPrice : na, "SL", color=color.red,   style=plot.style_linebr, linewidth=2)
plot(showSLTP and not na(tpPrice) ? tpPrice : na, "TP", color=color.green, style=plot.style_linebr, linewidth=2)

// Alerts
alertcondition(buyCond,  title="XAUUSD BUY Signal",  message="🟢 XAUUSD BUY @ {{close}} | SL: {{slPrice}} | TP: {{tpPrice}}")
alertcondition(sellCond, title="XAUUSD SELL Signal", message="🔴 XAUUSD SELL @ {{close}} | SL: {{slPrice}} | TP: {{tpPrice}}")

// ─── Dashboard ───
var table dash = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "XAUUSD MTF Signal", bgcolor=color.blue, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "", bgcolor=color.blue)
    table.cell(dash, 0, 1, "H1 Trend", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 1, h1Bull ? "🟢 BULL" : h1Bear ? "🔴 BEAR" : "⚪ FLAT", text_color=h1Bull ? color.green : h1Bear ? color.red : color.gray, text_size=size.tiny)
    table.cell(dash, 0, 2, "EMA Diff", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(diff, "#.##"), text_color=color.yellow, text_size=size.tiny)
    table.cell(dash, 0, 3, "Last Signal", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 3, lastSig, text_color=lastSig=="BUY"?color.green:lastSig=="SELL"?color.red:color.gray, text_size=size.tiny)
    table.cell(dash, 0, 4, "Price", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(close, "#.##"), text_color=color.white, text_size=size.tiny)