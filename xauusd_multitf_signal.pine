//@version=6
indicator("XAUUSD M15 PRO Ultra-Fast & Accurate", overlay=true)

// ─── SETTINGS (Tuned for Fast & Precise Scalping) ───
fastLen    = input.int(5,  "EMA Fast (M15)", group="Signal Settings")
slowLen    = input.int(13, "EMA Slow (M15)", group="Signal Settings")
h1Len      = input.int(20, "H1 Trend Filter Length", group="Signal Settings")
minDiff    = input.float(0.5, "Min EMA Momentum (pts)", step=0.1, group="Signal Settings")
atrLen     = input.int(14, "ATR Period", group="Risk Management")
atrMult    = input.float(1.2, "SL ATR Multiplier", step=0.1, group="Risk Management")
rrMult     = input.float(2.0, "TP Risk:Reward Ratio", step=0.1, group="Risk Management")

// ─── H1 TREND FILTER ───
h1Close = request.security(syminfo.tickerid, "60", close, lookahead=barmerge.lookahead_on)
h1Ema = ta.ema(h1Close, h1Len)
h1Bull = h1Close > h1Ema
h1Bear = h1Close < h1Ema

// ─── M15 MOMENTUM & CROSSOVER ───
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
momentum = emaFast - emaSlow

// MACD for confirmation
[_, _, macdHist] = ta.macd(close, 8, 17, 9)

// ─── SIGNAL CONDITIONS ───
// Cepat mendeteksi perubahan arah melalui persilangan EMA cepat + konfirmasi momentum MACD
buyCond  = h1Bull and ta.crossover(emaFast, emaSlow) and momentum >= minDiff and macdHist > 0
sellCond = h1Bear and ta.crossunder(emaFast, emaSlow) and momentum <= -minDiff and macdHist < 0

// ─── DEDUPLICATION & STATE ───
var string lastSig = "NONE"
string sig = "NONE"

if buyCond and lastSig != "BUY"
    sig := "BUY"
    lastSig := "BUY"
else if sellCond and lastSig != "SELL"
    sig := "SELL"
    lastSig := "SELL"

// ─── ATR SL / TP ───
atrVal = ta.atr(atrLen)
slDist = atrVal * atrMult
tpDist = slDist * rrMult

slPrice = sig == "BUY" ? close - slDist : sig == "SELL" ? close + slDist : na
tpPrice = sig == "BUY" ? close + tpDist : sig == "SELL" ? close - tpDist : na

// ─── PLOTTING ───
plot(emaFast, "EMA Fast (5)", color=color.green, linewidth=2)
plot(emaSlow, "EMA Slow (13)", color=color.red, linewidth=2)

bgcolor(h1Bull ? color.new(color.green, 92) : color.new(color.red, 92), title="H1 Trend BG")

plotshape(sig == "BUY",  "BUY",  shape.labelup,   location.belowbar, color.green, size=size.normal, text="🟢 BUY")
plotshape(sig == "SELL", "SELL", shape.labeldown, location.abovebar, color.red,   size=size.normal, text="🔴 SELL")

plot(sig == "BUY" or sig == "SELL" ? slPrice : na, "SL", color=color.red,   style=plot.style_linebr, linewidth=2)
plot(sig == "BUY" or sig == "SELL" ? tpPrice : na, "TP", color=color.green, style=plot.style_linebr, linewidth=2)

alertcondition(sig == "BUY",  title="BUY Alert",  message="🟢 XAUUSD BUY Signal")
alertcondition(sig == "SELL", title="SELL Alert", message="🔴 XAUUSD SELL Signal")

// ─── DASHBOARD ───
var table dash = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "XAUUSD Ultra-Fast", bgcolor=color.blue, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "", bgcolor=color.blue)
    table.cell(dash, 0, 1, "H1 Trend", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 1, h1Bull ? "🟢 BULL" : "🔴 BEAR", text_color=h1Bull ? color.green : color.red, text_size=size.tiny)
    table.cell(dash, 0, 2, "Momentum", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(momentum, "#.##"), text_color=momentum>0?color.green:color.red, text_size=size.tiny)
    table.cell(dash, 0, 1, "Last Signal", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 3, lastSig, text_color=lastSig=="BUY"?color.green:lastSig=="SELL"?color.red:color.gray, text_size=size.tiny)
