//@version=6
indicator("XAUUSD M15 PRO Signal (H1 Dual EMA + ADX Gate)", overlay=true)

// ─── SETTINGS ───
grp_main     = "Signal Settings"
fastLen      = input.int(9,  "EMA Fast (M15)", group=grp_main)
medLen       = input.int(21, "EMA Med (M15)", group=grp_main)
slowLen      = input.int(50, "EMA Slow (M15)", group=grp_main)
atrLen       = input.int(14, "ATR Period (M15)", group=grp_main)
rsiLen       = input.int(14, "RSI Period (M15)", group=grp_main)
h1EmaFast    = input.int(20, "H1 EMA Fast", group=grp_main)
h1EmaSlow    = input.int(50, "H1 EMA Slow", group=grp_main)
adxLen       = input.int(14, "ADX Period (H1)", group=grp_main)
adxMin       = input.float(20, "H1 ADX Min (Hard Gate)", step=1, group=grp_main) // Diturunkan dari 25 ke 20
pbTol        = input.float(0.8, "Pullback Tolerance (%)", step=0.1, group=grp_main) // Dinaikkan dari 0.5% ke 0.8%
rsiMin       = input.int(35, "RSI Min (Buy)", group=grp_main) // Diperluas
rsiMax       = input.int(75, "RSI Max (Buy)", group=grp_main) // Diperluas
rsiShortMin  = input.int(25, "RSI Min (Sell)", group=grp_main) // Diperluas
rsiShortMax  = input.int(65, "RSI Max (Sell)", group=grp_main) // Diperluas
minRR        = input.float(1.2, "Min Risk:Reward", step=0.1, group=grp_main) // Diturunkan dari 1.5 ke 1.2
atrMult      = input.float(1.5, "ATR Multiplier SL", step=0.1, group=grp_main)
rrMult       = input.float(2.0, "RR Multiple TP", step=0.1, group=grp_main)

grp_visual   = "Visual"
showLabels   = input.bool(true, "Show Buy/Sell Labels", group=grp_visual)
showSLTP     = input.bool(true, "Show SL/TP Lines", group=grp_visual)
showHTF      = input.bool(true, "Show H1 Trend Background", group=grp_visual)

grp_scoring  = "Scoring Weights (sum=1.0)"
wRegime      = input.float(0.30, "Regime Weight", step=0.05, group=grp_scoring)
wPullback    = input.float(0.20, "Pullback Weight", step=0.05, group=grp_scoring)
wRsi         = input.float(0.10, "RSI Weight", step=0.05, group=grp_scoring)
wAdx         = input.float(0.10, "ADX Weight", step=0.05, group=grp_scoring)
wVol         = input.float(0.10, "Volume Weight", step=0.05, group=grp_scoring)
wRr          = input.float(0.20, "RR Weight", step=0.05, group=grp_scoring)

// ─── CUSTOM ADX FUNCTION (Pine v6 compatible) ───
f_adx(float h, float l, float c, int len) =>
    float tr = math.max(math.max(h - l, math.abs(h - close[1])), math.abs(l - close[1]))
    float plusDM = h - h[1] > l[1] - l ? math.max(h - h[1], 0) : 0
    float minusDM = l[1] - l > h - h[1] ? math.max(l[1] - l, 0) : 0
    float atrVal = ta.rma(tr, len)
    float plusDI = 100 * ta.rma(plusDM, len) / atrVal
    float minusDI = 100 * ta.rma(minusDM, len) / atrVal
    float sumDI = plusDI + minusDI
    float dx = 100 * math.abs(plusDI - minusDI) / (sumDI == 0 ? 1 : sumDI)
    ta.rma(dx, len)

// ─── H1 DATA (Higher Timeframe) ───
[h1Close, h1High, h1Low, h1Open, h1Vol] = request.security(syminfo.tickerid, "60", [close, high, low, open, volume], lookahead=barmerge.lookahead_on)

// H1 EMAs (Dual EMA 20/50)
h1EmaF = ta.ema(h1Close, h1EmaFast)
h1EmaS = ta.ema(h1Close, h1EmaSlow)
h1EmaFPrev = h1EmaF[1]
h1EmaSPrev = h1EmaS[1]

// H1 ADX
h1Adx = f_adx(h1High, h1Low, h1Close, adxLen)

// H1 Slope
h1Slope = h1Close - h1Close[1]

// H1 Trend Determination
h1EmaBull = h1EmaF > h1EmaS
h1EmaBear = h1EmaF < h1EmaS
h1EmaSlopeUp = h1EmaF >= h1EmaFPrev and h1EmaS >= h1EmaSPrev
h1EmaSlopeDown = h1EmaF <= h1EmaFPrev and h1EmaS <= h1EmaSPrev

// HARD GATE: ADX < adxMin = NO TRADE ZONE
h1TradeZone = h1Adx >= adxMin
h1Trend = h1TradeZone ? (h1EmaBull and h1EmaSlopeUp ? "UPTREND" : h1EmaBear and h1EmaSlopeDown ? "DOWNTREND" : "TRANSITION") : "NO-TRADE (ADX<" + str.tostring(adxMin) + ")"

// ─── M15 CALCULATIONS ───
emaFast = ta.ema(close, fastLen)
emaMed  = ta.ema(close, medLen)
emaSlow = ta.ema(close, slowLen)

rsi = ta.rsi(close, rsiLen)
atrVal = math.max(ta.atr(atrLen), 1.50)

[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
macdHist = macdH
macdHistPrev = macdH[1]

// M15 ADX
m15Adx = f_adx(high, low, close, adxLen)

// ─── REGIME CLASSIFICATION ───
regime = "UNCERTAIN"
regimeConf = 0.0

h1AdxVal = h1Adx
m15AdxVal = m15Adx

if h1EmaBull and h1TradeZone
    regime := "STRONG_BULL"
    regimeConf := math.min((m15AdxVal + h1AdxVal) / 80.0, 1.0)
else if h1EmaBear and h1TradeZone
    regime := "STRONG_BEAR"
    regimeConf := math.min((m15AdxVal + h1AdxVal) / 80.0, 1.0)
else if h1EmaBull
    regime := "BULL"
    regimeConf := 0.5
else if h1EmaBear
    regime := "BEAR"
    regimeConf := 0.5
else
    regime := "UNCERTAIN"
    regimeConf := 0.4

// ─── PULLBACK DETECTION (M15) ───
isBull = h1EmaBull
isBear = h1EmaBear

emaAligned = isBull ? (emaFast >= emaMed) : isBear ? (emaFast <= emaMed) : false

pb21 = isBull ? (emaAligned and close <= emaMed * (1 + pbTol/100)) : isBear ? (emaAligned and close >= emaMed * (1 - pbTol/100)) : false
pb50 = isBull ? (emaAligned and close <= emaSlow * (1 + pbTol/100)) : isBear ? (emaAligned and close >= emaSlow * (1 - pbTol/100)) : false
isPullback = pb21 or pb50 or true // Lebih fleksibel agar tidak terlalu kaku

rsiOk = isBull ? (rsiMin <= rsi and rsi <= rsiMax) : isBear ? (rsiShortMin <= rsi and rsi <= rsiShortMax) : true
adxOk = m15AdxVal > 15
volOk = true // Volume filter dilonggarkan

// ─── RISK / REWARD ───
slDist = atrMult * atrVal
tpDist = slDist * rrMult

slPrice = isBull ? (close - slDist) : isBear ? (close + slDist) : na
tpPrice = isBull ? (close + tpDist) : isBear ? (close - tpDist) : na
rrVal = math.abs((tpPrice - close) / (close - slPrice))
rrOk = rrVal >= minRR

// ─── WEIGHTED SCORE (normalized 0-1) ───
float score = 0.0
if h1EmaBull or h1EmaBear
    score += wRegime * 1.0
if emaAligned
    score += wPullback * 1.0
if rsiOk
    score += wRsi * 1.0
if adxOk
    score += wAdx * 1.0
if rrOk
    score += wRr * 1.0

scoreNorm = math.min(score, 1.0)

// ─── CONFIDENCE FORMULA ───
confidence = math.round(regimeConf * (0.5 + 0.5 * scoreNorm), 2)

// ─── DYNAMIC THRESHOLD (Diturunkan sedikit agar lebih sering muncul) ───
dynamicThreshold = math.round(0.4 + 0.2 * (h1AdxVal / 40.0), 2)
dynamicThreshold := math.max(math.min(dynamicThreshold, 0.75), 0.50)

// ─── DIRECTION VALIDATION ───
m15Bull = emaFast > emaMed
m15Bear = emaFast < emaMed

longValid = isBull and m15Bull and rrOk
shortValid = isBear and m15Bear and rrOk

// ─── FINAL SIGNAL WITH H1 FILTER ───
var string lastSig = "NONE"
string sig = "NONE"

if longValid and confidence >= dynamicThreshold
    sig := "BUY"
else if shortValid and confidence >= dynamicThreshold
    sig := "SELL"

// Deduplication
if sig != "NONE" and sig != lastSig
    lastSig := sig
else
    sig := "NONE"

// ─── PLOTTING ───
plot(emaFast, "EMA Fast", color=color.green, linewidth=1)
plot(emaMed,  "EMA Med",  color=color.orange, linewidth=1)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=1)

// H1 Trend Background
bgcolor(h1EmaBull and showHTF ? color.new(color.green, 90) : h1EmaBear and showHTF ? color.new(color.red, 90) : na, title="H1 Trend")

// Signal Markers
plotshape(sig == "BUY" and showLabels,  "BUY",  shape.labelup,   location.belowbar, color.green,  size=size.normal, text="🟢 BUY")
plotshape(sig == "SELL" and showLabels, "SELL", shape.labeldown, location.abovebar, color.red,    size=size.normal, text="🔴 SELL")

// SL/TP Lines
plot(showSLTP and sig == "BUY" ? slPrice : showSLTP and sig == "SELL" ? slPrice : na, "SL", color=color.red,   style=plot.style_linebr, linewidth=2)
plot(showSLTP and sig == "BUY" ? tpPrice : showSLTP and sig == "SELL" ? tpPrice : na, "TP", color=color.green, style=plot.style_linebr, linewidth=2)

// Alerts
alertcondition(sig == "BUY",  title="XAUUSD BUY Signal",  message="🟢 XAUUSD BUY Signal Triggered")
alertcondition(sig == "SELL", title="XAUUSD SELL Signal", message="🔴 XAUUSD SELL Signal Triggered")

// ─── DASHBOARD TABLE ───
var table dash = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "XAUUSD M15 PRO Signal", bgcolor=color.blue, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "", bgcolor=color.blue)
    table.cell(dash, 0, 1, "H1 Trend", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 1, h1Trend, text_color=h1EmaBull?color.green:color.red, text_size=size.tiny)
    table.cell(dash, 0, 2, "H1 ADX", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(h1AdxVal, "#.##"), text_color=h1AdxVal>=adxMin?color.green:color.red, text_size=size.tiny)
    table.cell(dash, 0, 3, "Regime", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 3, regime, text_color=regimeConf>0.5?color.green:color.yellow, text_size=size.tiny)
    table.cell(dash, 0, 4, "Score / Conf", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(scoreNorm, "#.##") + " / " + str.tostring(confidence*100, "#.#") + "%", text_color=confidence>=dynamicThreshold?color.green:color.red, text_size=size.tiny)
    table.cell(dash, 0, 5, "Threshold", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(dynamicThreshold*100, "#.#") + "%", text_color=color.yellow, text_size=size.tiny)
    table.cell(dash, 0, 6, "Last Signal", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 6, lastSig, text_color=lastSig=="BUY"?color.green:lastSig=="SELL"?color.red:color.gray, text_size=size.tiny)